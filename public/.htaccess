RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.stexecutive\.com\.br [NC]
RewriteRule ^(.*)$ https://stexecutive.com.br/$1 [R=301,L]

# Artigos individuais do Guia Brasília são administrados pelo painel
# /admin (banco de dados) via guia-brasilia/artigo.php?slug=X, mas a
# pasta de export estático do Next.js também gera guia-brasilia/{slug}/
# no mesmo caminho. Reescreve a URL bonita para o script PHP real,
# mantendo a URL visível igual.
# Exclui os 5 artigos que ainda não foram cadastrados no banco (mais
# antigos que o painel admin) — esses continuam vindo do HTML estático,
# senão cairiam num "artigo não encontrado" do PHP.
RewriteRule ^guia-brasilia/(?!primeira-vez-em-brasilia|onde-ficar-em-brasilia|viagem-a-trabalho-para-brasilia|eventos-em-brasilia|o-que-fazer-em-brasilia-em-poucas-horas)([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1 [L,QSA]

# Guia Brasília em inglês/espanhol — sempre via PHP (não existe versão
# estática Next.js para nenhum artigo nesses idiomas ainda, então não há
# exclusão de slugs aqui como na regra em português acima).
RewriteRule ^en/guia-brasilia/?$ /guia-brasilia/index.php?lang=en [L,QSA]
RewriteRule ^en/guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1&lang=en [L,QSA]
RewriteRule ^es/guia-brasilia/?$ /guia-brasilia/index.php?lang=es [L,QSA]
RewriteRule ^es/guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1&lang=es [L,QSA]

# ── Cache de assets estáticos ───────────────────────────────
# Imagens/vídeos/fontes têm nome fixo e mudam junto com o deploy, então
# podem ficar muito tempo no cache do navegador. Os vídeos estavam sendo
# servidos sem Cache-Control nenhum — 6 MB rebaixados a cada visita.
# HTML fica de fora: precisa revalidar para o site atualizar na hora.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Os assets do Next.js já vêm com hash no nome — seguro marcar immutable.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Segurança: headers ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Segurança: bloquear acesso HTTP direto a arquivos sensíveis ──
<FilesMatch "^(smtp-config\.php|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_alias.c>
  RedirectMatch 403 ^/vendor/
</IfModule>
