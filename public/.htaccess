RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.stexecutive\.com\.br [NC]
RewriteRule ^(.*)$ https://stexecutive.com.br/$1 [R=301,L]

# Página 404 do próprio site (gerada pelo build do Next.js). Sem esta linha
# o Apache serve a página genérica da hospedagem, em inglês e sem layout.
ErrorDocument 404 /404.html

# Artigos individuais do Guia Brasília são administrados pelo painel
# /admin (banco de dados) via guia-brasilia/artigo.php?slug=X, mas a
# pasta de export estático do Next.js também gera guia-brasilia/{slug}/
# no mesmo caminho. Reescreve a URL bonita para o script PHP real,
# mantendo a URL visível igual.
# Até 2026-08-09 havia aqui uma exceção para 5 artigos que nunca tinham
# ido para o banco e por isso não apareciam na listagem do Guia. Eles
# foram migrados (guia-migrar-5-artigos.sql) e agora vêm do banco como
# todos os outros — sem exceção nenhuma nesta regra.
RewriteRule ^guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1 [L,QSA]

# Guia Brasília em inglês/espanhol — sempre via PHP (não existe versão
# estática Next.js para nenhum artigo nesses idiomas ainda, então não há
# exclusão de slugs aqui como na regra em português acima).
RewriteRule ^en/guia-brasilia/?$ /guia-brasilia/index.php?lang=en [L,QSA]
RewriteRule ^en/guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1&lang=en [L,QSA]
RewriteRule ^es/guia-brasilia/?$ /guia-brasilia/index.php?lang=es [L,QSA]
RewriteRule ^es/guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1&lang=es [L,QSA]

# ── Originais que o site nao usa ────────────────────────────
# O site inteiro e servido em .webp. Os .png e .jpg em /images/ sao os
# arquivos de origem, e nenhuma pagina aponta para eles.
#
# Isto nao e arrumacao: em 25/08/2026 descobriu-se que
# /images/content/sedan blindada .png ficava publicamente baixavel COM A
# PLACA DO CARRO LEGIVEL — a placa so havia sido apagada na versao .webp que
# aparece no site. Apagar do repositorio nao resolve sozinho, porque o deploy
# roda com dangerous-clean-slate:false e nao remove nada que ja esteja no
# servidor. Esta regra e o que fecha a porta hoje.
#
# O que NAO e bloqueado, de proposito:
#   .jpeg  -> /images/content/social.jpeg e a imagem de compartilhamento,
#             usada inclusive pelo Guia Brasilia;
#   .mp4 em /images/  -> "veide hero.mp4" e "video st vans.mp4" rodam no site;
#   /icon.png  -> favicon, fica na raiz e nao em /images/;
#   .webp  -> tudo que o site e o Guia realmente mostram.
# ATENCAO ao mexer aqui: o .jpg de /images/ NAO pode ser bloqueado.
# O Guia Brasilia gera um JPEG irmao de cada .webp usado como og:image
# (o WhatsApp falha em silencio com WebP) e o grava nesta mesma pasta.
# A primeira versao desta regra incluia jpg e derrubou a previa de link
# de 5 artigos do Guia — corrigido em 25/08/2026, no mesmo dia.
# O arquivo com a placa legivel e .png, entao continua bloqueado.
RewriteRule ^images/.*\.png$ - [F,L]
RewriteRule ^van.executiva.content/.*\.(mp4|png|jpe?g)$ - [F,L]
# Unico .jpeg de /images/ que o site nao usa (a versao publicada e a .webp).
RewriteRule ^images/content/stquemsomos\.jpeg$ - [F,L]

# ── Cache dos arquivos versionados ──────────────────────────
# Tudo em /_next/static/ carrega um codigo no proprio nome, trocado a cada
# publicacao. Nao ha como servir versao velha, entao um ano de cache e seguro
# e evita rebaixar o mesmo JS a cada 7 dias. Vale SO para esse caminho: as
# paginas do Guia Brasilia continuam com o no-store que o PHP define.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_next/static/" ARQUIVO_VERSIONADO=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ARQUIVO_VERSIONADO
</IfModule>

# ── Segurança: headers ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Segurança: bloquear acesso HTTP direto a arquivos sensíveis ──
<FilesMatch "^(smtp-config\.php|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_alias.c>
  RedirectMatch 403 ^/vendor/
</IfModule>
