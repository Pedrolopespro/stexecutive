RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.stexecutive\.com\.br [NC]
RewriteRule ^(.*)$ https://stexecutive.com.br/$1 [R=301,L]

# Página 404 do próprio site (gerada pelo build do Next.js). Sem esta linha
# o Apache serve a página genérica da hospedagem, em inglês e sem layout.
ErrorDocument 404 /404.html

# Artigos individuais do Guia Brasília são administrados pelo painel
# /admin (banco de dados) via guia-brasilia/artigo.php?slug=X, mas a
# pasta de export estático do Next.js também gera guia-brasilia/{slug}/
# no mesmo caminho. Reescreve a URL bonita para o script PHP real,
# mantendo a URL visível igual.
# Até 2026-08-09 havia aqui uma exceção para 5 artigos que nunca tinham
# ido para o banco e por isso não apareciam na listagem do Guia. Eles
# foram migrados (guia-migrar-5-artigos.sql) e agora vêm do banco como
# todos os outros — sem exceção nenhuma nesta regra.
RewriteRule ^guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1 [L,QSA]

# Guia Brasília em inglês/espanhol — sempre via PHP (não existe versão
# estática Next.js para nenhum artigo nesses idiomas ainda, então não há
# exclusão de slugs aqui como na regra em português acima).
RewriteRule ^en/guia-brasilia/?$ /guia-brasilia/index.php?lang=en [L,QSA]
RewriteRule ^en/guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1&lang=en [L,QSA]
RewriteRule ^es/guia-brasilia/?$ /guia-brasilia/index.php?lang=es [L,QSA]
RewriteRule ^es/guia-brasilia/([a-z0-9-]+)/?$ /guia-brasilia/artigo.php?slug=$1&lang=es [L,QSA]

# ── Segurança: headers ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Segurança: bloquear acesso HTTP direto a arquivos sensíveis ──
<FilesMatch "^(smtp-config\.php|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_alias.c>
  RedirectMatch 403 ^/vendor/
</IfModule>
